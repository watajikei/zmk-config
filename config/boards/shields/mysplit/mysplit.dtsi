#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    // columns = left cols (6) + right cols (5) = 11
    // rows = 4 (3 alpha rows + 1 thumb row) on each half
    //
    // Thumb key wiring (confirmed): left row3 = col4, col5.
    // Right row3 = col0, col1 (local, offset+6 = global col6, col7).
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                        RC(3,4) RC(3,5)             RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
    };
};

// The xiao_ble board enables UART0 by default, with TX on D6 (P1.11)
// and RX on D7 (P1.12). Our matrix uses D7 as a GPIO column (col2 on
// both halves), but UART0 was silently claiming it as its RX pin,
// making that whole column dead on both halves. Disabling UART0
// frees D7 for GPIO use.
&uart0 {
    status = "disabled";
};
