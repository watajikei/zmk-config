if SHIELD_MYSPLIT_LEFT

config ZMK_KEYBOARD_NAME
    default "MySplit"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Only the central side exposes a USB HID device - src/hid.c (which
# usb_hid.c depends on) is only compiled for the central role, so
# forcing this on for the peripheral breaks the link.
config ZMK_USB
    default y

endif # SHIELD_MYSPLIT_LEFT

if SHIELD_MYSPLIT_LEFT || SHIELD_MYSPLIT_RIGHT

config ZMK_SPLIT
    default y

# Explicitly force these on - v0.3's xiao_ble board doesn't seem to
# default them to y the way main does.
config ZMK_BLE
    default y

# Some Windows Bluetooth chipsets (Realtek/Intel) fail to pair when
# the 2Mbps PHY is advertised. Disabling it is a known workaround.
config BT_CTLR_PHY_2M
    default n

# Windows requires authenticated (MITM) pairing for BLE keyboards.
config ZMK_BLE_PASSKEY_ENTRY
    default y

# Without this, re-pairing to a host that already has a (possibly
# unauthenticated) bond can leave the encryption key out of sync -
# pairing appears to succeed but the host never gets real HID
# notifications afterward. Allows the new authenticated key to
# properly overwrite the old one.
config ZMK_BLE_EXPERIMENTAL_SEC
    default y

# Known Windows bug: it sometimes doesn't correctly subscribe to GATT
# notifications after pairing, so HID reports get silently dropped
# even though the connection shows as active. This works around it.
config BT_GATT_ENFORCE_SUBSCRIPTION
    default n

# Save battery by entering deep sleep when idle.
config ZMK_SLEEP
    default y

# Report battery level to the host.
config ZMK_BATTERY_REPORTING
    default y

endif # SHIELD_MYSPLIT_LEFT || SHIELD_MYSPLIT_RIGHT
