if SHIELD_MYSPLIT_LEFT

config ZMK_KEYBOARD_NAME
    default "MySplit"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_MYSPLIT_LEFT

if SHIELD_MYSPLIT_LEFT || SHIELD_MYSPLIT_RIGHT

config ZMK_SPLIT
    default y

# Explicitly force these on - v0.3's xiao_ble board doesn't seem to
# default them to y the way main does.
config ZMK_BLE
    default y

config ZMK_USB
    default y

# The USB HID class driver isn't being auto-selected under v0.3 for this
# board - force it on so usb_hid.c actually links.
config USB_HID_DEVICE
    default y

# Save battery by entering deep sleep when idle.
config ZMK_SLEEP
    default y

# Report battery level to the host.
config ZMK_BATTERY_REPORTING
    default y

endif # SHIELD_MYSPLIT_LEFT || SHIELD_MYSPLIT_RIGHT
