#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp V &kp S &kp Y &kp N9 &kp K &kp C>;
        };
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LS(D) &kp LS(A) &kp N6 &kp ENTER>;
        };
        macro_3: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp D &kp E &kp S &kp U>;
        };
        macro_4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp ENTER>
                , <&macro_release &kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // W+E -> layer 3 momentary (matches old MO(3) combo)
        combo_layer3 {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&mo 3>;
        };
        // K+L -> macro_4 (Alt+Enter)
        combo_macro4 {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&macro_4>;
        };
        // S+D -> Ctrl+X (cut)
        combo_cut {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp LC(X)>;
        };
        // D+F -> Ctrl+C (copy)
        combo_copy {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LC(C)>;
        };
        // F+G -> Ctrl+V (paste)
        combo_paste {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LC(V)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // col0 (new) is always TAB / SHIFT / CTRL per your instruction.
            // col1-5 on the left = old col0-4, shifted right by one.
            // Right half and thumb columns are unchanged from the old layout.
            bindings = <
&kp TAB   &kp Q          &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I    &kp O    &kp P
&kp LSHFT &kp A          &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K    &kp L    &mt LSHFT MINUS
&kp LCTRL &kp Z          &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH
                          &kp LC(Z) &lt 1 SPACE             &lt 2 ENTER &mo 3
            >;
        };

        nav_layer {
            bindings = <
&kp GRAVE &kp GRAVE  &kp TAB  &kp UP    &trans &trans     &trans &trans &kp SQT  &trans    &kp LBKT
&kp ESC   &kp ESC    &kp LEFT &kp DOWN  &kp RIGHT &trans  &trans &trans &kp HOME &kp PG_UP &kp BSPC
&trans &kp F2     &trans   &trans    &trans &kp LS(INT_RO)    &trans &kp DEL &kp END  &kp PG_DN &kp INT_RO
                            &trans &trans                     &trans &trans
            >;
        };

        symbol_layer {
            bindings = <
&trans &kp LS(N1)   &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)     &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp EQUAL
&trans &kp N1       &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
&trans &kp LS(SEMI) &kp LS(SQT) &kp F4    &kp F7     &kp F8         &kp F9     &kp F10    &kp COMMA  &kp DOT    &kp FSLH
                     &trans &trans                                  &trans &trans
            >;
        };

        macro_layer {
            bindings = <
&trans &trans  &kp KP_N4  &kp KP_N8 &kp LG(E) &kp LG(R)      &macro_0 &macro_1 &trans   &bt BT_CLR   &trans
&trans &bt BT_SEL 0  &bt BT_SEL 1  &kp KP_N2 &kp LG(D) &kp LS(LG(S))  &trans   &trans   &trans   &macro_4 &trans
&trans &trans  &trans     &trans    &trans    &bootloader    &bootloader &trans   &trans   &trans   &trans
                           &trans &trans                      &trans &trans
            >;
        };
    };
};
